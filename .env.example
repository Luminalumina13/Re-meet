# ---- Flight data connectors (any subset; none configured => demo data) ----
# Kiwi.com Tequila: https://tequila.kiwi.com
KIWI_API_KEY=
# Amadeus Self-Service: https://developers.amadeus.com  (AMADEUS_ENV=test|production)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
# Duffel: https://duffel.com
DUFFEL_ACCESS_TOKEN=
# Restrict providers (comma list: kiwi,amadeus,duffel) or force demo: PROVIDERS=mock
PROVIDERS=
# Also merge demo data alongside real providers (1/0)
INCLUDE_DEMO=0

# ---- Price tracking ----
# Where watches are persisted (JSON file store)
DATA_DIR=./data
# In-process scheduler interval in minutes (0/unset = disabled; use external cron instead)
WATCH_POLL_MINUTES=0
# Default min interval between checks for the cron endpoint /api/watches/check
WATCH_MIN_INTERVAL_MIN=30
# Protect the cron endpoint: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Telegram notifications (per-watch chat id is set in the UI)
TELEGRAM_BOT_TOKEN=
