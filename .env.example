# ---- Flight sources ----------------------------------------------------------
# Work out of the box, no keys (set to 0 to turn one off):
#   Kiwi.com public MCP server: hundreds of airlines incl. low-cost and self-transfer combos
KIWI_MCP_ENABLED=1
#   lastminute.com public MCP server: full-service and low-cost airlines, second price source
LASTMINUTE_MCP_ENABLED=1
#   Ryanair direct airline connector (public fare finder)
RYANAIR_ENABLED=1

# Need keys:
#   Duffel (300+ airlines via NDC; open sign-up, test token gives a fake "Duffel Airways"): https://duffel.com
DUFFEL_ACCESS_TOKEN=
#   Kiwi.com Tequila (invite-only since 2024)
KIWI_API_KEY=
#   Amadeus Enterprise (Self-Service portal closed on 17 July 2026)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=production

# Restrict sources (comma list of ids: kiwi,lastminute,ryanair,duffel,kiwi-tequila,amadeus)
# or force demo data: PROVIDERS=mock
PROVIDERS=
# Also merge demo data alongside real sources (1/0)
INCLUDE_DEMO=0
# Parallel requests per MCP source
KIWI_MCP_CONCURRENCY=8
LASTMINUTE_MCP_CONCURRENCY=6

# Behind an HTTP(S) proxy, Node's fetch needs this to honour HTTPS_PROXY (Node >= 22.21)
# NODE_USE_ENV_PROXY=1

# ---- Price tracking ----------------------------------------------------------
DATA_DIR=./data
# In-process scheduler interval in minutes (0/unset = disabled; use external cron instead)
WATCH_POLL_MINUTES=0
WATCH_MIN_INTERVAL_MIN=30
# Protect the cron endpoint: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
# polling = long polling for local dev; leave empty in production and use the webhook
TELEGRAM_MODE=
# Webhook mode: 16+ chars of A-Za-z0-9_-, then `npm run telegram:webhook -- https://your.domain`
TELEGRAM_WEBHOOK_SECRET=
# Optional: public URL of the app (adds an "open on the website" button) and the bot username (looked up automatically otherwise)
APP_URL=
TELEGRAM_BOT_USERNAME=
