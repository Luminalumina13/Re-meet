[Unit]
Description=Re:meeet (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
User=remeeet
WorkingDirectory=/opt/remeeet/current
EnvironmentFile=/etc/remeeet.env
Environment=NODE_OPTIONS=--max-old-space-size=384
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/remeeet /opt/remeeet/releases
PrivateTmp=true

[Install]
WantedBy=multi-user.target
